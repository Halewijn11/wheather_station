function doPost(e) {
  try {
    // Parse the incoming JSON payload from TTN
    var payload = JSON.parse(e.postData.contents);

    // 1. EXTRACT METADATA
    // Note: TTN payloads usually wrap these inside 'uplink_message'
    var msg = payload.uplink_message || payload; 
    
    var deviceId = payload.end_device_ids ? payload.end_device_ids.device_id : "N/A";
    var timeStamp = payload.received_at || new Date().toISOString();
    var rawPayload = msg.frm_payload || "N/A";
    
    // Extract RSSI and SNR from the first gateway metadata entry
    var rssi = (msg.rx_metadata && msg.rx_metadata[0]) ? msg.rx_metadata[0].rssi : "N/A";
    var snr = (msg.rx_metadata && msg.rx_metadata[0]) ? msg.rx_metadata[0].snr : "N/A";

    // 2. EXTRACT DECODED DATA
    var decoded = msg.decoded_payload || {};

    // Helper to safely get nested values (e.g., bmp_temperature.avg)
    function getVal(obj, key, subKey) {
      return (obj[key] && obj[key][subKey] !== undefined) ? obj[key][subKey] : "";
    }

    // Prepare the data row for the sheet
    var rowData = [
      timeStamp,
      deviceId,
      rssi,
      snr,
      rawPayload,
      decoded.version !== undefined ? decoded.version : "",
      // BMP Temperature
      getVal(decoded, 'bmp_temperature', 'avg'),
      getVal(decoded, 'bmp_temperature', 'max'),
      getVal(decoded, 'bmp_temperature', 'min'),
      // SHT Temperature
      getVal(decoded, 'sht_temperature', 'avg'),
      getVal(decoded, 'sht_temperature', 'max'),
      getVal(decoded, 'sht_temperature', 'min'),
      // SHT Humidity
      getVal(decoded, 'sht_humidity', 'avg'),
      getVal(decoded, 'sht_humidity', 'max'),
      getVal(decoded, 'sht_humidity', 'min'),
      // Pressure
      getVal(decoded, 'pressure_pa', 'avg'),
      getVal(decoded, 'pressure_pa', 'max'),
      getVal(decoded, 'pressure_pa', 'min'),
      //light sensor 
      getVal(decoded, 'light_solar', 'avg'),
      getVal(decoded, 'light_solar', 'max'),
      getVal(decoded, 'light_solar', 'min'),

      // Wind
      getVal(decoded, 'wind', 'direction_deg'),
      getVal(decoded, 'wind', 'pulses_max'),
      getVal(decoded, 'wind', 'pulses_min'),
      getVal(decoded, 'wind', 'pulses_total'),
      // Rain
      // getVal(decoded, 'wind', 'pulses_total'),
      decoded.rain_pulses !== undefined ? decoded.rain_pulses : "",
      // Battery Voltage (mV) - V4+
      decoded.battery_v !== undefined ? decoded.battery_v : "",

      // 14. Wind Speed (km/h) - new fields appended at the end, existing columns untouched
      getVal(decoded.wind || {}, 'speed_kmh', 'avg'),
      getVal(decoded.wind || {}, 'speed_kmh', 'max'),
      // Rain (mm) - converted from pulses (0.2 mm/tip) by the payload decoder
      decoded.rain_mm !== undefined ? decoded.rain_mm : ""
    ];

    // 3. LOG TO SHEET
    var scriptProperties = PropertiesService.getScriptProperties();
    var sheetId = scriptProperties.getProperty("SHEET_ID");
    if (!sheetId) throw new Error("Sheet ID not found in Script Properties.");
    
    var sheet = SpreadsheetApp.openById(sheetId).getSheetByName("Sheet1");
    sheet.appendRow(rowData);

    return ContentService.createTextOutput("Success").setMimeType(ContentService.MimeType.TEXT);
    
  } catch (error) {
    return ContentService.createTextOutput("Error: " + error.message).setMimeType(ContentService.MimeType.TEXT);
  }
}

// Public read-only endpoint for the iPhone widget (Scriptable).
// Returns { latest: {...}, today: [...] } built from columns:
// A=timestamp, J=sht_temperature.avg, S=light_solar.avg, AB=wind.speed_kmh.avg, AD=rain_mm
function doGet(e) {
  try {
    var scriptProperties = PropertiesService.getScriptProperties();
    var sheetId = scriptProperties.getProperty("SHEET_ID");
    if (!sheetId) throw new Error("Sheet ID not found in Script Properties.");

    var sheet = SpreadsheetApp.openById(sheetId).getSheetByName("Sheet1");
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return jsonOutput({ latest: null, today: [] });
    }

    // Columns A, J, S, AB, AD -> 1, 10, 19, 28, 30
    var numRows = lastRow - 1; // exclude header row
    var values = sheet.getRange(2, 1, numRows, 30).getValues();

    var records = values.map(function (row) {
      var ts = row[0] instanceof Date ? row[0] : new Date(row[0]);
      return {
        timestamp: ts,
        temp_c: row[9] === "" ? null : row[9],
        light: row[18] === "" ? null : row[18],
        wind_kmh: row[27] === "" ? null : row[27],
        rain_mm: row[29] === "" ? null : row[29]
      };
    }).filter(function (r) {
      return !isNaN(r.timestamp.getTime());
    });

    var latest = records.length ? records[records.length - 1] : null;

    var todayStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");
    var today = records.filter(function (r) {
      return Utilities.formatDate(r.timestamp, Session.getScriptTimeZone(), "yyyy-MM-dd") === todayStr;
    });

    function serialize(r) {
      return {
        timestamp: r.timestamp.toISOString(),
        temp_c: r.temp_c,
        light: r.light,
        wind_kmh: r.wind_kmh,
        rain_mm: r.rain_mm
      };
    }

    return jsonOutput({
      latest: latest ? serialize(latest) : null,
      today: today.map(serialize)
    });
  } catch (error) {
    return jsonOutput({ error: error.message });
  }
}

function jsonOutput(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}