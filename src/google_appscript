function doPost(e) {
  try {
    // Parse the incoming JSON payload from TTN
    var payload = JSON.parse(e.postData.contents);

    // 1. EXTRACT METADATA
    // Note: TTN payloads usually wrap these inside 'uplink_message'
    var msg = payload.uplink_message || payload; 
    
    var deviceId = payload.end_device_ids ? payload.end_device_ids.device_id : "N/A";
    var timeStamp = payload.received_at || new Date().toISOString();
    var rawPayload = msg.frm_payload || "N/A";
    
    // Extract RSSI and SNR from the first gateway metadata entry
    var rssi = (msg.rx_metadata && msg.rx_metadata[0]) ? msg.rx_metadata[0].rssi : "N/A";
    var snr = (msg.rx_metadata && msg.rx_metadata[0]) ? msg.rx_metadata[0].snr : "N/A";

    // 2. EXTRACT DECODED DATA
    var decoded = msg.decoded_payload || {};

    // Helper to safely get nested values (e.g., bmp_temperature.avg)
    function getVal(obj, key, subKey) {
      return (obj[key] && obj[key][subKey] !== undefined) ? obj[key][subKey] : "";
    }

    // Prepare the data row for the sheet
    var rowData = [
      timeStamp,
      deviceId,
      rssi,
      snr,
      rawPayload,
      decoded.version !== undefined ? decoded.version : "",
      // BMP Temperature
      getVal(decoded, 'bmp_temperature', 'avg'),
      getVal(decoded, 'bmp_temperature', 'max'),
      getVal(decoded, 'bmp_temperature', 'min'),
      // SHT Temperature
      getVal(decoded, 'sht_temperature', 'avg'),
      getVal(decoded, 'sht_temperature', 'max'),
      getVal(decoded, 'sht_temperature', 'min'),
      // SHT Humidity
      getVal(decoded, 'sht_humidity', 'avg'),
      getVal(decoded, 'sht_humidity', 'max'),
      getVal(decoded, 'sht_humidity', 'min'),
      // Pressure
      getVal(decoded, 'pressure_pa', 'avg'),
      getVal(decoded, 'pressure_pa', 'max'),
      getVal(decoded, 'pressure_pa', 'min'),
      //light sensor 
      getVal(decoded, 'light_solar', 'avg'),
      getVal(decoded, 'light_solar', 'max'),
      getVal(decoded, 'light_solar', 'min'),

      // Wind
      getVal(decoded, 'wind', 'direction_deg'),
      getVal(decoded, 'wind', 'pulses_max'),
      getVal(decoded, 'wind', 'pulses_min'),
      getVal(decoded, 'wind', 'pulses_total'),
      // Rain
      // getVal(decoded, 'wind', 'pulses_total'),
      decoded.rain_pulses !== undefined ? decoded.rain_pulses : "",
      // Battery Voltage (mV) - V4+
      decoded.battery_v !== undefined ? decoded.battery_v : "",

      // 14. Wind Speed (km/h) - new fields appended at the end, existing columns untouched
      getVal(decoded.wind || {}, 'speed_kmh', 'avg'),
      getVal(decoded.wind || {}, 'speed_kmh', 'max'),
      // Rain (mm) - converted from pulses (0.2 mm/tip) by the payload decoder
      decoded.rain_mm !== undefined ? decoded.rain_mm : ""
    ];

    // 3. LOG TO SHEET
    var scriptProperties = PropertiesService.getScriptProperties();
    var sheetId = scriptProperties.getProperty("SHEET_ID");
    if (!sheetId) throw new Error("Sheet ID not found in Script Properties.");
    
    var sheet = SpreadsheetApp.openById(sheetId).getSheetByName("Sheet1");
    sheet.appendRow(rowData);

    // New uplink landed, so the widget's cached payload is stale.
    CacheService.getScriptCache().remove(WIDGET_CACHE_KEY);

    return ContentService.createTextOutput("Success").setMimeType(ContentService.MimeType.TEXT);
    
  } catch (error) {
    return ContentService.createTextOutput("Error: " + error.message).setMimeType(ContentService.MimeType.TEXT);
  }
}

// Public read-only endpoint for the iPhone widgets (Scriptable).
// Returns { latest: {...}, today: [...] } built from columns:
// A=timestamp, J=sht_temperature.avg, M=sht_humidity.avg, P=pressure_pa.avg,
// S=light_solar.avg, V=wind.direction_deg, AB=wind.speed_kmh.avg, AD=rain_mm
//
// Deliberately ONE generic endpoint carrying the full sensor field set per
// row, rather than a per-widget projection: a new widget (light-over-time,
// pressure-over-time, ...) then needs no backend change. The range read below
// already pulls all 30 columns, so extra fields cost nothing but JSON size.
// Bump WIDGET_CACHE_KEY whenever a field is added, else a cached response
// from the previous shape is served to a widget that needs the new field.
//
// This ran ~38s before, which is longer than a phone widget will wait. Three
// things were paying for that and all three are fixed below:
//   1. it read EVERY row the sheet has ever held, then threw away all but
//      today -> now reads only the tail (WIDGET_MAX_ROWS)
//   2. it called Utilities.formatDate once PER ROW to test "is this today",
//      and that call is expensive -> now computes the day boundary ONCE and
//      compares plain millisecond values
//   3. every widget refresh recomputed from scratch -> now cached, and
//      doPost drops the cache when a new uplink lands
var WIDGET_CACHE_KEY = "widget_payload_v2";
var WIDGET_CACHE_SECONDS = 300;
// Uplinks arrive roughly every 5 min (~288 rows/day). 600 still covers a full
// day if the interval halves, and keeps the read small.
var WIDGET_MAX_ROWS = 600;

// Midnight-today in the script's timezone, as epoch ms. Computed once per
// request instead of formatting every row's date.
function startOfTodayMs_() {
  var now = new Date();
  var z = Utilities.formatDate(now, Session.getScriptTimeZone(), "Z"); // e.g. "+0200"
  var sign = z.charAt(0) === "-" ? -1 : 1;
  var offsetMs = sign * (parseInt(z.substr(1, 2), 10) * 60 + parseInt(z.substr(3, 2), 10)) * 60000;
  var DAY_MS = 86400000;
  return Math.floor((now.getTime() + offsetMs) / DAY_MS) * DAY_MS - offsetMs;
}

function doGet(e) {
  try {
    var cache = CacheService.getScriptCache();
    var cached = cache.get(WIDGET_CACHE_KEY);
    if (cached) return jsonString(cached);

    var scriptProperties = PropertiesService.getScriptProperties();
    var sheetId = scriptProperties.getProperty("SHEET_ID");
    if (!sheetId) throw new Error("Sheet ID not found in Script Properties.");

    var sheet = SpreadsheetApp.openById(sheetId).getSheetByName("Sheet1");
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return jsonOutput({ latest: null, today: [] });
    }

    // Columns A, J, M, P, S, V, AB, AD -> 1, 10, 13, 16, 19, 22, 28, 30
    var startRow = Math.max(2, lastRow - WIDGET_MAX_ROWS + 1);
    var values = sheet.getRange(startRow, 1, lastRow - startRow + 1, 30).getValues();

    var dayStartMs = startOfTodayMs_();
    var latest = null;
    var today = [];

    for (var i = 0; i < values.length; i++) {
      var row = values[i];
      var ts = row[0] instanceof Date ? row[0] : new Date(row[0]);
      var ms = ts.getTime();
      if (isNaN(ms)) continue;

      var rec = {
        timestamp: ts.toISOString(),
        temp_c: row[9] === "" ? null : row[9],
        humidity: row[12] === "" ? null : row[12],
        pressure_pa: row[15] === "" ? null : row[15],
        light: row[18] === "" ? null : row[18],
        wind_dir_deg: row[21] === "" ? null : row[21],
        wind_kmh: row[27] === "" ? null : row[27],
        rain_mm: row[29] === "" ? null : row[29]
      };

      latest = rec; // rows are chronological, so the last valid one wins
      if (ms >= dayStartMs) today.push(rec);
    }

    var body = JSON.stringify({ latest: latest, today: today });
    // 100KB is the per-entry cache limit; a day of rows is ~35KB, but skip the
    // put rather than throw if the sheet ever gets chattier.
    if (body.length < 100000) cache.put(WIDGET_CACHE_KEY, body, WIDGET_CACHE_SECONDS);
    return jsonString(body);
  } catch (error) {
    return jsonOutput({ error: error.message });
  }
}

function jsonOutput(obj) {
  return jsonString(JSON.stringify(obj));
}

function jsonString(body) {
  return ContentService.createTextOutput(body).setMimeType(ContentService.MimeType.JSON);
}